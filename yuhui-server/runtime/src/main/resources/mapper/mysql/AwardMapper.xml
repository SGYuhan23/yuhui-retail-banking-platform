<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuhui.infrastructure.dao.AwardMapper">

    <resultMap id="BaseResultMap" type="com.yuhui.infrastructure.dao.po.Award">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="awardKey" column="award_key" jdbcType="VARCHAR"/>
        <result property="awardConfig" column="award_config" jdbcType="VARCHAR"/>
        <result property="image" column="image" jdbcType="VARCHAR"/>
        <result property="awardDesc" column="award_desc" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="queryAwardList" resultMap="BaseResultMap">
        select id, award_key, award_config, image, award_desc, create_time, update_time
        from award order by update_time desc
    </select>

</mapper>

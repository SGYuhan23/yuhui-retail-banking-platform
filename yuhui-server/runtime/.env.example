# DEMO_ONLY: example values; do not commit real credentials.
# Copy this file to `.env` in the project root or to `runtime/.env`.
# Only fill in the critical connection values. The rest stays in application.yml.

# MySQL for db-router
app.infra.mysql.host=127.0.0.1
app.infra.mysql.port=3306
app.infra.mysql.username=root
app.infra.mysql.password=change-me

# Redis
app.infra.redis.host=127.0.0.1
app.infra.redis.port=6379
app.infra.redis.password=
app.infra.redis.database=6

# RabbitMQ
app.infra.rabbitmq.host=127.0.0.1
app.infra.rabbitmq.port=5672
app.infra.rabbitmq.username=guest
app.infra.rabbitmq.password=example-password
app.infra.rabbitmq.virtual-host=/

# Elasticsearch
app.infra.es.host=127.0.0.1
app.infra.es.port=9200
app.infra.es.username=elastic
app.infra.es.password=change-me

# Registry and coordination
app.infra.nacos.host=127.0.0.1
app.infra.nacos.port=8848
app.infra.zookeeper.host=127.0.0.1
app.infra.zookeeper.port=2181
app.infra.xxl.host=127.0.0.1
app.infra.xxl.port=9091

# Auth
app.auth.tenant-id=2
app.authing.app-id=change-me
app.authing.app-secret=change-me
app.authing.app-host=https://your-app.authing.cn

# OSS / MinIO
app.infra.alioss.endpoint=https://oss-cn-beijing.aliyuncs.com
app.infra.alioss.access-key-id=change-me
app.infra.alioss.access-key-secret=change-me
app.infra.alioss.bucket-name=change-me
; app.infra.minio.host=127.0.0.1
; app.infra.minio.port=9001
; app.infra.minio.access-key=change-me
; app.infra.minio.access-secret=change-me
; app.infra.minio.bucket-name=change-me

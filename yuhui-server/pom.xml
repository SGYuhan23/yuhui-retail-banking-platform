            <!-- 工程模块 -->
            <dependency>
                <groupId>com.yuhui</groupId>
                <artifactId>contracts</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.yuhui</groupId>
                <artifactId>marketing</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.yuhui</groupId>
                <artifactId>storage</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.yuhui</groupId>
                <artifactId>shared</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.yuhui</groupId>
                <artifactId>entrypoints</artifactId>
                <version>1.0-SNAPSHOT</version>
